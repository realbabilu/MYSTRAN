$ SAP2000 Problem 5-001 / MacNeal-Harder - Eight independent solid patches
$ DO NOT CONNECT THE PATCHES. One homogeneous PSOLID / MAT1 per group.
$ Enforcement: SPC1 on surface + SPCD in static LOAD case.
$ Note: validate SPCD nonzero support on the selected MYSTRAN build.
SOL 101
CEND
TITLE = 5-001 CPENTA REMESH GPSTRESS 8 VOLUMES
SUBCASE 1
  LABEL = AFFINE_DISPLACEMENT_PATCH
  SPC = 1
  LOAD = 1
  DISPLACEMENT(PLOT) = ALL
  STRESS(PLOT) = ALL
  STRAIN(PLOT) = ALL
  GPSTRESS(PRINT,PLOT) = ALL
$ Separate stress recovery volumes, SET contains element IDs
OUTPUT(POST)
$ VOLUME 1: CTETRA4, PID 1, 168 elements
SET 101 = 100001 THRU 100168
VOLUME 1, SET 101, SYSTEM BASIC
$ VOLUME 2: CTETRA10, PID 2, 168 elements
SET 102 = 200001 THRU 200168
VOLUME 2, SET 102, SYSTEM BASIC
$ VOLUME 3: CPENTA6, PID 3, 14 elements
SET 103 = 300001 THRU 300014
VOLUME 3, SET 103, SYSTEM BASIC
$ VOLUME 4: CPENTA15, PID 4, 14 elements
SET 104 = 400001 THRU 400014
VOLUME 4, SET 104, SYSTEM BASIC
$ VOLUME 5: CHEXA8, PID 5, 7 elements
SET 105 = 500001 THRU 500007
VOLUME 5, SET 105, SYSTEM BASIC
$ VOLUME 6: CHEXA20, PID 6, 7 elements
SET 106 = 600001 THRU 600007
VOLUME 6, SET 106, SYSTEM BASIC
$ VOLUME 7: CPYRAM5, PID 7, 42 elements
SET 107 = 700001 THRU 700042
VOLUME 7, SET 107, SYSTEM BASIC
$ VOLUME 8: CPYRAM13, PID 8, 42 elements
SET 108 = 800001 THRU 800042
VOLUME 8, SET 108, SYSTEM BASIC
BEGIN BULK
PARAM,POST,-1
PARAM,SOLIDTYP,NEWSOLID
